# Environment Variable Configuration

# LLM Provider (Groq — free, fast, required for LLM reasoning)
GROQ_API_KEY=

# Qdrant Vector Database (local by default — no key needed for local)
# For Qdrant Cloud: set the URL and API key below
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ML Inference Service URL (python -m uvicorn ... --port 8001)
ML_SERVICE_URL=http://localhost:8001

# Backend Settings
LOG_LEVEL=INFO
ENVIRONMENT=development

# Frontend API URL (used by Next.js — must be prefixed NEXT_PUBLIC_)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Database (SQLite path — relative to backend/ directory)
# To use PostgreSQL: postgresql://user:password@localhost:5432/financial_safety
DATABASE_URL=sqlite:///./data/financial_copilot.db
